# Copy to deploy.env on the server; keep deploy.env private and out of Git.
DB_NAME=heatingpump
DB_USER=heatingapp
# Generate a URL-safe hexadecimal value: openssl rand -hex 32
DB_PASSWORD=replace_with_openssl_rand_hex_32
# Generate independently: openssl rand -hex 48
SESSION_SECRET=replace_with_openssl_rand_hex_48
POLICY_VERSION=1.0
APP_ORIGIN=https://example.com
SITE_ADDRESS=example.com
# Keep disabled until production readiness and the request flow are verified.
LEADS_ENABLED=false
