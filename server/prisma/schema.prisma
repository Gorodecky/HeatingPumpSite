generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id                  String     @id @default(uuid()) @db.Uuid
  createdAt           DateTime   @default(now())
  lastContactAt       DateTime   @default(now())
  status              LeadStatus @default(NEW)
  source              String     @db.VarChar(20)
  city                String?    @db.VarChar(100)
  area                String?    @db.VarChar(40)
  objectType          String?    @db.VarChar(80)
  heatingSystem       String?    @db.VarChar(80)
  realizationTiming   String?    @db.VarChar(80)
  name                String     @db.VarChar(100)
  phone               String     @db.VarChar(30)
  comment             String?    @db.VarChar(2000)
  consentGiven        Boolean    @default(false)
  consentAt           DateTime?
  policyVersion       String     @db.VarChar(40)
  notification        LeadNotification?

  @@index([createdAt])
  @@index([status, createdAt])
}

enum LeadNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model LeadNotification {
  id               String                  @id @default(uuid()) @db.Uuid
  leadId           String                  @unique @db.Uuid
  lead             Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status           LeadNotificationStatus  @default(PENDING)
  attempts         Int                     @default(0)
  firstAttemptAt   DateTime?
  manualRetryCount Int                     @default(0)
  lastManualRetryAt DateTime?
  nextAttemptAt    DateTime                @default(now())
  lockedAt         DateTime?
  sentAt           DateTime?
  lastErrorCode    String?                 @db.VarChar(100)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status, nextAttemptAt])
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(80)
  passwordHash String
  createdAt    DateTime @default(now())
}
